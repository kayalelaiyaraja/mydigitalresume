
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080808">
  <meta name="description" content="Kayal's personal digital resume and portfolio. IT student and aspiring software engineer.">

  <title>Kayal | Digital Resume</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Dancing+Script:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    :root {
      --bg: #080808;
      --card: #111111;
      --red: #ff304f;
      --red-dark: #bd1732;
      --white: #f5f5f5;
      --muted: #a6a6a6;
      --border: #292929;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--white);
      font-family: 'Inter', sans-serif;
      line-height: 1.7;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    /* NAVIGATION */

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      padding: 16px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(8, 8, 8, .92);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      z-index: 1000;
    }

    .logo {
      font-size: 25px;
      font-weight: 800;
      color: var(--white);
    }

    .logo span {
      color: var(--red);
    }

    .nav-links {
      display: flex;
      gap: 25px;
      list-style: none;
    }

    .nav-links a {
      color: #ccc;
      font-size: 13px;
      transition: .3s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--red);
    }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      color: var(--red);
      font-size: 24px;
      cursor: pointer;
    }

    /* COMMON SECTIONS */

    section {
      padding: 85px 8%;
      scroll-margin-top: 65px;
    }

    .section-title {
      font-size: 30px;
      margin-bottom: 30px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .section-title i {
      color: var(--red);
    }

    .section-title::after {
      content: "";
      width: 55px;
      height: 3px;
      background: var(--red);
      border-radius: 5px;
      margin-left: 4px;
    }

    .accent {
      color: var(--red);
    }

    .card {
      background: linear-gradient(145deg, #141414, #0c0c0c);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 25px;
      transition: .3s;
    }

    .card:hover {
      border-color: var(--red);
      transform: translateY(-5px);
      box-shadow: 0 8px 30px #ff304f10;
    }

    .muted {
      color: var(--muted);
    }

    /* HERO */

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      gap: 55px;
      padding-top: 120px;
      background:
        radial-gradient(ellipse at 85% 25%, #ff304f12, transparent 35%),
        var(--bg);
    }

    .hero-content {
      flex: 1;
    }

    .hero-tag {
      color: var(--red);
      border: 1px solid #ff304f55;
      background: #ff304f0c;
      display: inline-block;
      padding: 6px 15px;
      border-radius: 30px;
      font-size: 12px;
      letter-spacing: 1px;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(43px, 7vw, 76px);
      line-height: 1.15;
      margin-bottom: 12px;
    }

    .signature {
      font-family: 'Dancing Script', cursive;
      color: var(--red);
    }

    .hero h2 {
      font-size: clamp(17px, 2.5vw, 25px);
      color: #ddd;
      margin-bottom: 16px;
    }

    .hero p {
      max-width: 570px;
      color: var(--muted);
      margin-bottom: 25px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      padding: 12px 22px;
      border: 1px solid var(--red);
      border-radius: 7px;
      cursor: pointer;
      transition: .3s;
      font-size: 14px;
    }

    .btn-primary {
      background: var(--red);
      color: white;
    }

    .btn-outline {
      color: var(--red);
      background: transparent;
    }

    .btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 20px #ff304f30;
    }

    .hero-image {
      width: 290px;
      height: 340px;
      flex-shrink: 0;
      border: 2px solid var(--red);
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 0 35px #ff304f22;
      position: relative;
      background: #151515;
    }

    .hero-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .image-placeholder {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--red);
      gap: 15px;
      font-size: 65px;
    }

    .image-placeholder span {
      font-size: 15px;
      color: var(--muted);
    }

    /* ABOUT */

    .about-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 25px;
    }

    .about-text {
      color: #c5c5c5;
    }

    .quote {
      font-family: 'Dancing Script', cursive;
      font-size: 27px;
      color: var(--red);
      text-align: center;
    }

    .mini-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 25px;
    }

    .stat {
      text-align: center;
      padding: 17px 8px;
      background: #151515;
      border-radius: 10px;
      border: 1px solid var(--border);
    }

    .stat i {
      display: block;
      color: var(--red);
      font-size: 21px;
      margin-bottom: 7px;
    }

    .stat span {
      font-size: 12px;
      color: #bbb;
    }

    /* EDUCATION */

    .education-item {
      border-left: 3px solid var(--red);
      margin-left: 8px;
      padding: 5px 0 5px 23px;
      position: relative;
    }

    .education-item::before {
      content: "";
      position: absolute;
      left: -9px;
      top: 10px;
      height: 13px;
      width: 13px;
      background: var(--red);
      border-radius: 50%;
      box-shadow: 0 0 12px #ff304f66;
    }

    .education-item h3 {
      font-size: 18px;
    }

    .education-item p {
      color: var(--muted);
      margin-top: 7px;
    }

    /* SKILLS */

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .skill-card h3 {
      margin-bottom: 17px;
    }

    .skill-card h3 i {
      color: var(--red);
      margin-right: 9px;
    }

    .skill {
      margin-bottom: 16px;
    }

    .skill-label {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      margin-bottom: 7px;
    }

    .skill-label span:last-child {
      color: var(--red);
    }

    .skill-bar {
      height: 7px;
      background: #292929;
      border-radius: 20px;
      overflow: hidden;
    }

    .skill-fill {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--red-dark), var(--red));
      border-radius: 20px;
      transition: width 1.2s ease;
    }

    .skill-fill.animate {
      width: var(--level);
    }

    .skill-note {
      font-size: 12px;
      color: var(--muted);
      margin-top: 12px;
    }

    /* PROJECTS */

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .project-icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      background: #ff304f18;
      color: var(--red);
      border-radius: 12px;
      font-size: 22px;
      margin-bottom: 17px;
    }

    .project-card h3 {
      margin-bottom: 8px;
    }

    .project-card p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 17px;
    }

    .tech-tags {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .tech-tags span {
      color: #ff8295;
      background: #ff304f12;
      border: 1px solid #ff304f28;
      border-radius: 5px;
      padding: 4px 9px;
      font-size: 11px;
    }

    .project-link {
      color: var(--red);
      font-size: 13px;
    }

    /* INTERESTS */

    .interests-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 17px;
    }

    .interest {
      text-align: center;
    }

    .interest i {
      font-size: 30px;
      color: var(--red);
      margin-bottom: 12px;
    }

    .interest h3 {
      font-size: 15px;
      margin-bottom: 7px;
    }

    .interest p {
      font-size: 12px;
      color: var(--muted);
    }

    /* CONTACT */

    .contact-grid {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 25px;
    }

    .contact-info {
      display: grid;
      gap: 18px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 13px;
      overflow-wrap: anywhere;
    }

    .contact-item i {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      background: #ff304f16;
      color: var(--red);
      border-radius: 9px;
      flex-shrink: 0;
    }

    .contact-item small {
      display: block;
      color: var(--muted);
    }

    .contact-form {
      display: grid;
      gap: 14px;
    }

    .contact-form input,
    .contact-form textarea {
      width: 100%;
      padding: 13px 15px;
      background: #090909;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: white;
      font: inherit;
      outline: none;
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
      border-color: var(--red);
    }

    .contact-form textarea {
      resize: vertical;
      min-height: 120px;
    }

    /* FOOTER */

    footer {
      padding: 25px 8%;
      text-align: center;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 13px;
    }

    .socials {
      display: flex;
      justify-content: center;
      gap: 22px;
      margin-bottom: 13px;
    }

    .socials a {
      font-size: 21px;
      color: var(--red);
      transition: .3s;
    }

    .socials a:hover {
      transform: translateY(-4px);
    }

    .back-top {
      position: fixed;
      right: 22px;
      bottom: 22px;
      width: 43px;
      height: 43px;
      display: grid;
      place-items: center;
      background: var(--red);
      color: white;
      border-radius: 10px;
      opacity: 0;
      pointer-events: none;
      transition: .3s;
      z-index: 900;
    }

    .back-top.show {
      opacity: 1;
      pointer-events: auto;
    }

    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: .7s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* RESPONSIVE DESIGN */

    @media (max-width: 850px) {
      .navbar {
        padding: 14px 6%;
      }

      .menu-btn {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 65px;
        left: 0;
        width: 100%;
        flex-direction: column;
        gap: 0;
        padding: 12px 6% 20px;
        background: #0d0d0d;
        border-bottom: 1px solid var(--border);
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        display: block;
        padding: 10px 0;
      }

      section {
        padding: 75px 6%;
      }

      .hero {
        flex-direction: column-reverse;
        text-align: center;
        gap: 30px;
        padding-top: 110px;
      }

      .hero-image {
        width: 230px;
        height: 260px;
      }

      .hero p {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-buttons {
        justify-content: center;
      }

      .about-grid,
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .section-title {
        font-size: 24px;
      }

      .skills-grid,
      .projects-grid {
        grid-template-columns: 1fr;
      }

      .interests-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .mini-stats {
        gap: 7px;
      }

      .stat span {
        font-size: 10px;
      }

      .card {
        padding: 19px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
      }
    }

    /* PRINT / SAVE AS PDF */

    @media print {
      .navbar, .hero-buttons, .back-top,
      .contact-form, .socials {
        display: none !important;
      }

      body {
        background: white;
        color: #111;
      }

      section {
        padding: 25px 10px;
        min-height: auto;
      }

      .card {
        background: white;
        color: #111;
        border: 1px solid #ccc;
        box-shadow: none;
        break-inside: avoid;
      }

      .muted, .about-text, .project-card p,
      .interest p, .education-item p {
        color: #444;
      }

      .reveal {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</head>

